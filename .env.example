# ─────────────────────────────────────────────────────────────────
# SF Validation Manager — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets!
# ─────────────────────────────────────────────────────────────────

# ── Salesforce Connected App Credentials ──────────────────────────
# Get these from: Salesforce Setup → App Manager → Your Connected App
SF_CLIENT_ID=YOUR_CONNECTED_APP_CONSUMER_KEY
SF_CLIENT_SECRET=YOUR_CONNECTED_APP_CONSUMER_SECRET

# ── Salesforce Login URL ──────────────────────────────────────────
# Use https://login.salesforce.com for production/developer orgs
# Use https://test.salesforce.com for sandbox orgs
SF_LOGIN_URL=https://login.salesforce.com

# ── React App (Frontend) ─────────────────────────────────────────
# These are exposed to the browser — do NOT put secrets here
REACT_APP_SF_CLIENT_ID=YOUR_CONNECTED_APP_CONSUMER_KEY
REACT_APP_SF_REDIRECT_URI=http://localhost:3000/oauth/callback
REACT_APP_SF_LOGIN_URL=https://login.salesforce.com

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
